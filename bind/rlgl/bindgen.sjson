inputs = [
	"../../input/rlgl.h",
]

output_folder = "out"
imports_file = "imports.odin"
package_name = "rlgl"

remove_type_prefix = "rl"
remove_macro_prefix = "RL_"
remove_function_prefix = "rl"

// "Old_Name" = "New_Name"
rename = {
    "rlglInit" = "Init"
    "rlglClose" = "Close"
}

// "Enum_To_Turn_Into_Bitset" = "New_Enum_Type_Name"
bit_setify = {
}

type_overrides = {
	"Matrix"  = "rl.Matrix"
	
	"rlPixelFormat" = "rl.PixelFormat"
	"rlTextureFilter" = "rl.TextureFilter"
	"rlBlendMode" = "rl.BlendMode"
	"rlShaderLocationIndex" = "rl.ShaderLocationIndex"
	"rlShaderUniformDataType" = "rl.ShaderUniformDataType"
}

struct_field_overrides = {
    "rlVertexBuffer.vertices" = "[^]"
    "rlVertexBuffer.texcoords" = "[^]"
    "rlVertexBuffer.normals" = "[^]"
    "rlVertexBuffer.colors" = "[^]"
    "rlVertexBuffer.indices" = "[^]VertexBufferIndexType"
    
    "rlRenderBatch.vertexBuffer" = "[^]"
    "rlRenderBatch.draws" = "[^]"    
}

remove_enum_member_prefix = {
    "rlGlVersion" = "RL_"
}

procedure_type_overrides = {
    "rlMultMatrixf.matf" = "[^]"
    
    "rlSetCullFace.mode" = "CullMode"
    
    "rlGetShaderLocsDefault" = "[^]"
    
    "rlGetGlTextureFormats.glInternalFormat" = "[^]"
    "rlGetGlTextureFormats.glFormat" = "[^]"
    "rlGetGlTextureFormats.glType" = "[^]"
    "rlReadScreenPixels" = "[^]"
    
    "rlSetUniformMatrices.mat" = "[^]"
    "rlSetShader.locs" = "[^]"
}

procedures_at_end = false

remove = [
    "RL_DEFAULT_BATCH_BUFFER_ELEMENTS"
]

clang_include_paths = [
	"/usr/lib/clang/22/include/"
]